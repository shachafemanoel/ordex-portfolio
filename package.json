{
  "name": "ordex-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "dev": "sh -c 'lsof -t -i:3000 | xargs kill -9 2>/dev/null || true' && next dev --port 3000",
    "dev:clean": "rm -rf .next && npm run dev",
    "dev:db": "docker-compose -f docker-compose.dev.yml up -d redis-dev",
    "test:smoke:db": "docker compose -f docker-compose.dev.yml up -d postgres-dev",
    "test:smoke:prep": "npx dotenv -e .env.test -- npx prisma migrate deploy",
    "dev:db:stop": "docker-compose -f docker-compose.dev.yml down",
    "dev:full": "npm run dev:db && npm run dev",
    "start:dev": "npm run dev:db && npm run dev",
    "build": "npx prisma generate && next build",
    "start": "PORT=${PORT:-3000} HOSTNAME=0.0.0.0 next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "start:standalone": "PORT=${PORT:-3000} HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "render-start": "bash scripts/render-start.sh",
    "start:prod": "NODE_ENV=production ./scripts/startup.sh",
    "seed": "tsx prisma/seed.ts",
    "seed:customer-templates": "tsx scripts/seed-customer-message-templates.ts",
    "seed:deploy-demo": "tsx scripts/seed-deploy-demo.ts",
    "seed:products": "tsx scripts/seed-products.ts",
    "seed:redis": "tsx scripts/seed-redis.ts",
    "seed:realistic": "tsx scripts/seed-realistic-data.ts",
    "seed:orders:service": "tsx scripts/seed-orders-via-service.ts",
    "seed:orders:advance": "tsx scripts/advance-service-seeded-orders.ts",
    "seed:orders:activate": "tsx scripts/activate-service-seeded-orders.ts",
    "seed:complete": "tsx scripts/seed-complete-10.ts",
    "seed:prod-test": "tsx scripts/seed-production-test.ts",
    "seed:oms:demo": "tsx scripts/seed-oms-demo.ts",
    "db:reset:dev": "npm exec prisma migrate reset -- --force --skip-seed && npm exec prisma generate && npm run seed:oms:demo",
    "warm": "tsx scripts/warm-cache.ts",
    "demo": "tsx scripts/generate-demo.ts",
    "migrate": "npx prisma migrate deploy",
    "worker:reminders": "tsx workers/reminders.ts",
    "reminders:run": "tsx workers/reminders.ts",
    "worker:ops-reminders": "tsx workers/ops-reminders.ts",
    "worker:callbacks": "tsx workers/callbacks.ts",
    "queues": "node ./dist/queues/index.js",
    "sync:woo": "tsx scripts/wooSync.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "smoke:health": "node -e \"(async()=>{const r=await fetch('http://localhost:3000/api/health');console.log(await r.json())})()\"",
    "smoke:bootstrap": "node -e \"(async()=>{const r=await fetch('http://localhost:3000/api/bootstrap');console.log(await r.json())})()\"",
    "test": "vitest run --reporter=verbose",
    "test:mvp": "vitest run --config vitest.mvp.config.ts",
    "test:release": "vitest run --config vitest.release.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage --reporter=verbose",
    "lint": "eslint .",
    "check:legacy-statuses": "node scripts/check-no-legacy-statuses.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ui:tokens:check": "node scripts/check-ui-shared-boundaries.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "typecheck": "npm exec prisma generate && tsc -p tsconfig.typecheck.json",
    "type-check": "npm exec prisma generate && tsc -p tsconfig.typecheck.json",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "quality:ci": "./scripts/quality-gates.sh",
    "health:check": "curl -f http://localhost:${PORT:-3000}/api/health || exit 1",
    "health:detailed": "curl -s http://localhost:${PORT:-3000}/api/health?detailed=true | jq .",
    "db:check-errors": "tsx scripts/fix-database-errors.ts",
    "db:fix-errors": "tsx scripts/fix-database-errors.ts",
    "db:repair-product-enums": "tsx scripts/repair-product-enums.ts --dry-run",
    "db:repair-product-enums:apply": "tsx scripts/repair-product-enums.ts --apply",
    "db:repair-user-roles": "tsx scripts/repair-user-role-enum.ts",
    "health:external": "curl -s http://localhost:${PORT:-3000}/api/health/external | jq .",
    "deploy:prod": "./scripts/deploy-production.sh",
    "deploy:render": "RENDER_SERVICE_WEB_ID=$RENDER_SERVICE_WEB_ID RENDER_SERVICE_WORKER_ID=$RENDER_SERVICE_WORKER_ID CLEAR_CACHE=${CLEAR_CACHE:-false} ./scripts/deploy-render.sh",
    "deploy:check": "./scripts/health-check.sh production",
    "reminders:send": "node dist/scripts/sendReminders.js",
    "reconciliation": "node dist/scripts/reconcileWoo.js",
    "woo-sync": "node dist/scripts/wooSync.js",
    "woocommerce:fetch": "node scripts/fetch-woocommerce-orders.js",
    "woocommerce:sync": "node scripts/fetch-woocommerce-orders.js --sync",
    "seed:rbac": "ts-node scripts/seed-rbac.ts",
    "customers:reconcile": "ts-node scripts/customer-reconciler.ts",
    "backfill:customers": "tsx scripts/backfill-order-customers.ts",
    "backfill:customers:dry": "tsx scripts/backfill-order-customers.ts --dry-run",
    "backfill:tasks": "tsx scripts/backfill-active-tasks.ts",
    "logs:view": "docker-compose -f docker-compose.production.yml logs -f oms-app",
    "logs:errors": "docker-compose -f docker-compose.production.yml logs oms-app | grep -i error",
    "backup:create": "node scripts/database-backup.mjs create",
    "docker:build": "docker build -t ordex-oms:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.production ordex-oms:latest",
    "docker:prod": "docker-compose -f docker-compose.production.yml up -d",
    "docker:prod:worker": "docker-compose -f docker-compose.production.yml up -d worker",
    "docker:dev": "docker compose up -d",
    "docker:dev:down": "docker compose down",
    "docker:dev:logs": "docker compose logs -f",
    "worker": "node --import tsx workers/woocommerce.ts",
    "worker:woocommerce": "node --import tsx workers/woocommerce.ts",
    "demo": "bash scripts/demo/local.sh",
    "docker:stop": "docker-compose -f docker-compose.production.yml down",
    "docker:restart": "npm run docker:stop && npm run docker:prod",
    "postdeploy": "./scripts/post-deploy.sh",
    "postdeploy:health": "./scripts/post-deploy-health-check.sh",
    "postinstall": "npm exec prisma generate",
    "prisma:format": "npm exec prisma format",
    "prisma:validate": "npm exec prisma validate",
    "db:generate": "npm exec prisma generate",
    "db:deploy": "npm exec prisma migrate deploy",
    "db:seed": "npm run seed",
    "typecheck:wide": "tsc -p tsconfig.typecheck.json",
    "typecheck:budget": "node scripts/typecheck-budget.mjs",
    "build:verify": "npm run prisma:format && npm run prisma:validate && npm run db:generate && npm run typecheck:budget && npm run lint",
    "woo:sync": "node -e \"(async()=>{const r=await fetch('http://localhost:3000/api/woo/sync/catalog',{method:'POST'});console.log(await r.json())})()\"",
    "e2e": "playwright test",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:acceptance": "playwright test tests/e2e/mvp-acceptance.spec.ts tests/e2e/woo-acceptance.spec.ts tests/e2e/frozen-modules.spec.ts",
    "smoke:local": "npm run test:smoke:db && npm run test:smoke:prep && npm run test:smoke",
    "prisma:studio": "npx prisma studio",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "skills:add": "node scripts/sync-skills.mjs add",
    "skills:sync": "node scripts/sync-skills.mjs sync",
    "skills:setup": "node scripts/sync-skills.mjs setup",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "import:catalog": "npx dotenv -e .env -- npx ts-node scripts/import-woo-catalog.ts",
    "release:migrate": "bash scripts/release-migrate.sh",
    "dev:setup": "bash scripts/dev-setup.sh",
    "backup:verify": "node scripts/database-backup.mjs verify"
  },
