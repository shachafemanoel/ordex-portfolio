/* Tailwind CSS temporarily removed due to build issues */
/* Using custom CSS instead */

/* Performance Optimizations */
* {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* GPU Acceleration for animations */
.transition-all,
[class*='transition-'] {
  will-change: transform, opacity;
  transform: translateZ(0);
  backface-visibility: hidden;
}

/* Respect user's motion preferences */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ============================================
   LIGHT MODE (DEFAULT)
   ============================================ */

:root,
.light {
  /* Light Mode Theme Tokens */
  --ordex-bg: #ffffff; /* Clean white background */
  --ordex-bg-soft: #f8fafc; /* Soft gray for cards/panels */
  --ordex-primary: #7c3aed; /* Purple accent */
  --ordex-primary-soft: #8b5cf6; /* Lighter purple for hovers */
  --ordex-accent: #06d6a0; /* Cyan-green accent */
  --ordex-text-main: #0f172a; /* Dark text */
  --ordex-text-muted: #64748b; /* Muted gray text */
  --ordex-border: #e2e8f0; /* Light border */
  --ordex-danger: #ef4444; /* Red danger */

  /* SHADCN UI TOKENS (Light) */
  --background: 0 0% 100%;
  --foreground: 222.2 84% 4.9%;
  --card: 0 0% 100%;
  --card-foreground: 222.2 84% 4.9%;
  --popover: 0 0% 100%;
  --popover-foreground: 222.2 84% 4.9%;
  --primary: 262.1 83.3% 57.8%;
  --primary-foreground: 210 40% 98%;
  --secondary: 210 40% 96.1%;
  --secondary-foreground: 222.2 47.4% 11.2%;
  --muted: 210 40% 96.1%;
  --muted-foreground: 215.4 16.3% 46.9%;
  --accent: 210 40% 96.1%;
  --accent-foreground: 222.2 47.4% 11.2%;
  --destructive: 0 84.2% 60.2%;
  --destructive-foreground: 210 40% 98%;
  --border: 214.3 31.8% 91.4%;
  --input: 214.3 31.8% 91.4%;
  --ring: 262.1 83.3% 57.8%;
  --radius: 0.5rem;

  /* Extended Palette - Light Mode */
  --tokyo-neon-pink: #ec4899;
  --tokyo-neon-blue: #0ea5e9;
  --tokyo-neon-purple: #a855f7;
  --tokyo-neon-green: #10b981;
  --tokyo-sunset-orange: #f97316;
  --tokyo-night-deep: #ffffff;
  --tokyo-glow: rgba(124, 58, 237, 0.1);

  /* Legacy & Helper Scales - Light Mode */
  --primary-50: #faf5ff;
  --primary-100: #f3e8ff;
  --primary-200: #e9d5ff;
  --primary-300: #d8b4fe;
  --primary-400: #c084fc;
  --primary-500: #a855f7;
  --primary-600: #7c3aed;
  --primary-700: #6d28d9;
  --primary-800: #5b21b6;
  --primary-900: #4c1d95;
  --primary-950: #2e1065;

  --secondary-50: #f8fafc;
  --secondary-100: #f1f5f9;
  --secondary-200: #e2e8f0;
  --secondary-300: #cbd5e1;
  --secondary-400: #94a3b8;
  --secondary-500: #64748b;
  --secondary-600: #475569;
  --secondary-700: #334155;
  --secondary-800: #1e293b;
  --secondary-900: #0f172a;

  --success-50: #f0fdf4;
  --success-100: #dcfce7;
  --success-200: #bbf7d0;
  --success-300: #86efac;
  --success-400: #4ade80;
  --success-500: #22c55e;
  --success-600: #16a34a;
  --success-700: #15803d;
  --success-800: #166534;
  --success-900: #14532d;

  --warning-50: #fffbeb;
  --warning-100: #fef3c7;
  --warning-200: #fde68a;
  --warning-300: #fcd34d;
  --warning-400: #fbbf24;
  --warning-500: #f59e0b;
  --warning-600: #d97706;
  --warning-700: #b45309;
  --warning-800: #92400e;
  --warning-900: #78350f;

  --error-50: #fef2f2;
  --error-100: #fee2e2;
  --error-200: #fecaca;
  --error-300: #fca5a5;
  --error-400: #f87171;
  --error-500: #ef4444;
  --error-600: #dc2626;
  --error-700: #b91c1c;
  --error-800: #991b1b;
  --error-900: #7f1d1d;

  --neutral-50: #fafafa;
  --neutral-100: #f5f5f5;
  --neutral-200: #e5e5e5;
  --neutral-300: #d4d4d4;
  --neutral-400: #a3a3a3;
  --neutral-500: #737373;
  --neutral-600: #525252;
  --neutral-700: #404040;
  --neutral-800: #262626;
  --neutral-900: #171717;

  /* Light Mode Shadows */
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  --shadow-2xl: 0 25px 50px -12px rgb(0 0 0 / 0.25);
  --shadow-glow: 0 0 15px rgba(124, 58, 237, 0.2);
  --shadow-glow-accent: 0 0 15px rgba(6, 214, 160, 0.2);

  color-scheme: light;
}

/* ============================================
   🌃 NIGHT TOKYO THEME (DARK MODE)
   A dark cyberpunk-inspired theme with neon accents
   Inspired by Tokyo's vibrant nightlife
   ============================================ */

.dark {
  /* Night Tokyo Theme Tokens */
  --ordex-bg: #0d1117; /* Deep night sky */
  --ordex-bg-soft: #161b22; /* Card/panel background - elevated surfaces */
  --ordex-primary: #7c3aed; /* Neon purple - main accent */
  --ordex-primary-soft: #a78bfa; /* Lighter purple for hovers */
  --ordex-accent: #06d6a0; /* Electric cyan-green */
  --ordex-text-main: #f0f6fc; /* Bright white text */
  --ordex-text-muted: #8b949e; /* Muted gray text */
  --ordex-border: #30363d; /* Subtle dark border */
  --ordex-danger: #ff6b6b; /* Neon red */

  /* SHADCN UI TOKENS (Dark) */
  --background: 222.2 84% 4.9%;
  --foreground: 210 40% 98%;
  --card: 222.2 84% 4.9%;
  --card-foreground: 210 40% 98%;
  --popover: 222.2 84% 4.9%;
  --popover-foreground: 210 40% 98%;
  --primary: 263.4 70% 50.4%;
  --primary-foreground: 210 40% 98%;
  --secondary: 217.2 32.6% 17.5%;
  --secondary-foreground: 210 40% 98%;
  --muted: 217.2 32.6% 17.5%;
  --muted-foreground: 215 20.2% 65.1%;
  --accent: 217.2 32.6% 17.5%;
  --accent-foreground: 210 40% 98%;
  --destructive: 0 62.8% 30.6%;
  --destructive-foreground: 210 40% 98%;
  --border: 217.2 32.6% 17.5%;
  --input: 217.2 32.6% 17.5%;
  --ring: 263.4 70% 50.4%;

  /* Night Tokyo Extended Palette */
  --tokyo-neon-pink: #ff6eb4;
  --tokyo-neon-blue: #00d4ff;
  --tokyo-neon-purple: #bf5af2;
  --tokyo-neon-green: #06d6a0;
  --tokyo-sunset-orange: #ff9f43;
  --tokyo-night-deep: #0a0c10;
  --tokyo-glow: rgba(124, 58, 237, 0.15);

  /* Legacy & Helper Scales - Night Mode */
  --primary-50: #1e1b4b;
  --primary-100: #312e81;
  --primary-200: #3730a3;
  --primary-300: #4338ca;
  --primary-400: #4f46e5;
  --primary-500: #6366f1;
  --primary-600: #7c3aed;
  --primary-700: #8b5cf6;
  --primary-800: #a78bfa;
  --primary-900: #c4b5fd;
  --primary-950: #ede9fe;

  --secondary-50: #0d1117;
  --secondary-100: #161b22;
  --secondary-200: #21262d;
  --secondary-300: #30363d;
  --secondary-400: #484f58;
  --secondary-500: #6e7681;
  --secondary-600: #8b949e;
  --secondary-700: #b1bac4;
  --secondary-800: #c9d1d9;
  --secondary-900: #f0f6fc;

  --success-50: #064e3b;
  --success-100: #065f46;
  --success-200: #047857;
  --success-300: #059669;
  --success-400: #10b981;
  --success-500: #06d6a0;
  --success-600: #34d399;
  --success-700: #6ee7b7;
  --success-800: #a7f3d0;
  --success-900: #d1fae5;

  --warning-50: #78350f;
  --warning-100: #92400e;
  --warning-200: #b45309;
  --warning-300: #d97706;
  --warning-400: #f59e0b;
  --warning-500: #fbbf24;
  --warning-600: #fcd34d;
  --warning-700: #fde68a;
  --warning-800: #fef3c7;
  --warning-900: #fffbeb;

  --error-50: #7f1d1d;
  --error-100: #991b1b;
  --error-200: #b91c1c;
  --error-300: #dc2626;
  --error-400: #ef4444;
  --error-500: #ff6b6b;
  --error-600: #fca5a5;
  --error-700: #fecaca;
  --error-800: #fee2e2;
  --error-900: #fef2f2;

  --neutral-50: #0a0c10;
  --neutral-100: #0d1117;
  --neutral-200: #161b22;
  --neutral-300: #21262d;
  --neutral-400: #30363d;
  --neutral-500: #484f58;
  --neutral-600: #6e7681;
  --neutral-700: #8b949e;
  --neutral-800: #c9d1d9;
  --neutral-900: #f0f6fc;

  /* Night Tokyo Shadows - with neon glow */
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.3);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.4), 0 2px 4px -2px rgb(0 0 0 / 0.3);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.4), 0 4px 6px -4px rgb(0 0 0 / 0.3);
  --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.5), 0 8px 10px -6px rgb(0 0 0 / 0.4);
  --shadow-2xl: 0 25px 50px -12px rgb(0 0 0 / 0.6);
  --shadow-glow: 0 0 20px rgba(124, 58, 237, 0.3), 0 0 40px rgba(124, 58, 237, 0.1);
  --shadow-glow-accent: 0 0 20px rgba(6, 214, 160, 0.3), 0 0 40px rgba(6, 214, 160, 0.1);

  color-scheme: dark;
}

/* Common Design Tokens (Spacing, Border Radius, Typography, Z-index) */
:root {
  /* Spacing */
  --spacing-xs: 0.25rem;
  --spacing-sm: 0.5rem;
  --spacing-md: 1rem;
  --spacing-lg: 1.5rem;
  --spacing-xl: 2rem;
  --spacing-2xl: 3rem;
  --spacing-3xl: 4rem;

  /* Border radius */
  --radius-xs: 0.125rem;
  --radius-sm: 0.25rem;
  --radius-md: 0.375rem;
  --radius-lg: 0.5rem;
  --radius-xl: 0.75rem;
  --radius-2xl: 1rem;
  --radius-3xl: 1.5rem;
  --radius-full: 9999px;

  /* Typography - Using system fonts */
  --font-primary:
    system-ui, -apple-system, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  --font-secondary:
    system-ui, -apple-system, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  --font-heading:
    system-ui, -apple-system, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;

  /* Z-index scale */
  --z-dropdown: 1000;
  --z-sticky: 1020;
  --z-fixed: 1030;
  --z-modal-backdrop: 1040;
  --z-modal: 1050;
  --z-popover: 1060;
  --z-tooltip: 1070;
  --z-toast: 1080;
}

html {
  direction: rtl;
  font-family: var(--font-primary);
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  background-color: var(--ordex-bg);
  color: var(--ordex-text-main);
  line-height: 1.6;
  font-feature-settings: 'ss01', 'ss02', 'cv05', 'cv11';
  transition:
    background-color 0.3s ease,
    color 0.3s ease;
}

/* Enhanced typography */
h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-heading);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--ordex-text-main);
  transition: color 0.3s ease;
}

.dark h1 {
  text-shadow: 0 0 30px rgba(124, 58, 237, 0.3);
}

strong,
b {
  font-weight: 600;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--ordex-bg);
}

::-webkit-scrollbar-thumb {
  background: var(--ordex-border);
  border-radius: 4px;
  transition: background 0.3s ease;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--ordex-primary);
  box-shadow: var(--shadow-glow);
}

/* Component Styles */
@layer components {
  .btn-primary {
    @apply bg-ordex-primary text-white font-bold px-4 py-2 rounded-lg transition-all;
    box-shadow: var(--shadow-glow);
  }

  .btn-primary:hover {
    @apply bg-ordex-primary-soft;
    transform: translateY(-1px);
  }

  .dark .btn-primary:hover {
    box-shadow: 0 0 25px rgba(124, 58, 237, 0.5);
  }

  /* Neon glow effect for interactive elements (dark mode only) */
  .dark .neon-glow {
    box-shadow: var(--shadow-glow);
    transition: box-shadow 0.3s ease;
  }

  .dark .neon-glow:hover {
    box-shadow: 0 0 30px rgba(124, 58, 237, 0.5);
  }

  .dark .neon-glow-accent {
    box-shadow: var(--shadow-glow-accent);
  }

  .dark .neon-glow-accent:hover {
    box-shadow: 0 0 30px rgba(6, 214, 160, 0.5);
  }

  /* Cards */
  .card-tokyo {
    background: var(--ordex-bg-soft);
    border: 1px solid var(--ordex-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }

  /* Neon text effects (dark mode only) */
  .dark .text-neon-purple {
    color: var(--ordex-primary);
    text-shadow: 0 0 10px rgba(124, 58, 237, 0.5);
  }

  .dark .text-neon-cyan {
    color: var(--tokyo-neon-blue);
    text-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
  }

  .dark .text-neon-pink {
    color: var(--tokyo-neon-pink);
    text-shadow: 0 0 10px rgba(255, 110, 180, 0.5);
  }

  .dark .text-neon-green {
    color: var(--tokyo-neon-green);
    text-shadow: 0 0 10px rgba(6, 214, 160, 0.5);
  }
}

/* Base Layer Overrides */
@layer base {
  /* Backgrounds */
  .bg-white {
    background-color: var(--ordex-bg-soft);
    transition: background-color 0.3s ease;
  }

  .bg-gray-50 {
    background-color: var(--ordex-bg);
    transition: background-color 0.3s ease;
  }

  .bg-gray-100 {
    background-color: var(--secondary-200);
    transition: background-color 0.3s ease;
  }

  /* Borders */
  .border-gray-200,
  .border-gray-300 {
    border-color: var(--ordex-border);
    transition: border-color 0.3s ease;
  }

  .divide-gray-200 > :not([hidden]) ~ :not([hidden]),
  .divide-gray-100 > :not([hidden]) ~ :not([hidden]) {
    border-color: var(--ordex-border);
    transition: border-color 0.3s ease;
  }

  /* Text colors */
  .text-gray-900 {
    color: var(--ordex-text-main);
    transition: color 0.3s ease;
  }

  .text-gray-700,
  .text-gray-800 {
    color: var(--secondary-800);
    transition: color 0.3s ease;
  }

  .text-gray-600,
  .text-gray-500 {
    color: var(--ordex-text-muted);
    transition: color 0.3s ease;
  }

  .text-gray-400 {
    color: var(--secondary-600);
    transition: color 0.3s ease;
  }

  /* Input styling */
  input,
  textarea,
  select {
    background-color: var(--ordex-bg);
    border-color: var(--ordex-border);
    color: var(--ordex-text-main);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--ordex-text-muted);
    transition: color 0.3s ease;
  }

  input:focus,
  textarea:focus,
  select:focus {
    border-color: var(--ordex-primary);
    box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.2);
    outline: none;
  }

  /* Table styling */
  thead {
    background-color: var(--ordex-bg);
    transition: background-color 0.3s ease;
  }

  tbody tr {
    transition: background-color 0.2s ease;
  }

  tbody tr:hover {
    background-color: var(--secondary-200);
  }

  /* Status colors adjusted for theme */
  .bg-green-50 {
    background-color: rgba(6, 214, 160, 0.1);
  }

  .dark .bg-green-50 {
    background-color: rgba(6, 214, 160, 0.15);
  }

  .bg-green-100 {
    background-color: rgba(6, 214, 160, 0.15);
  }

  .dark .bg-green-100 {
    background-color: rgba(6, 214, 160, 0.2);
  }

  .bg-blue-50 {
    background-color: rgba(124, 58, 237, 0.1);
  }

  .dark .bg-blue-50 {
    background-color: rgba(124, 58, 237, 0.15);
  }

  .bg-blue-100 {
    background-color: rgba(124, 58, 237, 0.15);
  }

  .dark .bg-blue-100 {
    background-color: rgba(124, 58, 237, 0.2);
  }

  .bg-yellow-50 {
    background-color: rgba(251, 191, 36, 0.1);
  }

  .dark .bg-yellow-50 {
    background-color: rgba(251, 191, 36, 0.15);
  }

  .bg-red-50 {
    background-color: rgba(239, 68, 68, 0.1);
  }

  .dark .bg-red-50 {
    background-color: rgba(255, 107, 107, 0.15);
  }

  .ring-blue-100 {
    --tw-ring-color: rgba(124, 58, 237, 0.2);
  }
}

/* Map RTL Support */
.leaflet-rtl .leaflet-control-attribution {
  text-align: left !important;
}

.leaflet-rtl .leaflet-control-zoom {
  right: 10px !important;
  left: auto !important;
}

.leaflet-rtl .leaflet-control-layers {
  right: 10px !important;
  left: auto !important;
}

.leaflet-rtl .leaflet-popup-content-wrapper {
  text-align: right !important;
}

.leaflet-rtl .leaflet-popup-content {
  direction: rtl !important;
}

/* Leaflet theme-aware overrides */
.leaflet-container {
  background-color: var(--ordex-bg);
  transition: background-color 0.3s ease;
}

.leaflet-popup-content-wrapper {
  background-color: var(--ordex-bg-soft);
  color: var(--ordex-text-main);
  transition:
    background-color 0.3s ease,
    color 0.3s ease;
}

.leaflet-popup-tip {
  background-color: var(--ordex-bg-soft);
  transition: background-color 0.3s ease;
}

@media (max-width: 768px) {
  .leaflet-container {
    font-size: 12px;
  }
  .leaflet-popup-content {
    font-size: 13px;
    min-width: 200px !important;
  }
  .leaflet-control-zoom {
    transform: scale(0.9);
  }
}

/* Toast Animations & Accessibility */
@keyframes toast-progress {
  from {
    width: 100%;
  }
  to {
    width: 0%;
  }
}

/* Neon pulse animation (dark mode only) */
@keyframes neon-pulse {
  0%,
  100% {
    box-shadow: 0 0 20px rgba(124, 58, 237, 0.3);
  }
  50% {
    box-shadow: 0 0 30px rgba(124, 58, 237, 0.6);
  }
}

.dark .animate-neon-pulse {
  animation: neon-pulse 2s ease-in-out infinite;
}

@media (prefers-contrast: high) {
  [role='alert'],
  [role='status'] {
    border: 2px solid currentColor;
  }
}

@media (prefers-reduced-motion: reduce) {
  .animate-toast-progress,
  .animate-neon-pulse {
    animation: none !important;
  }
}
