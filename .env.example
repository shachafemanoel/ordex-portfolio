# Environment Configuration for Ordex OMS
NODE_ENV=production
APP_URL=https://RENDER_SERVICE_HOST
PORT=10000
AUTO_SEED_DEMO_DATA=false

# Admin Setup (for initial provisioning and password reset)
# Production users are provisioned by invitation; no default admin password.

# Database
# PostgreSQL (Supabase / Prisma Postgres). Never commit real credentials.
# After git pull: run `npm run migrate` so the DB matches prisma/schema (fixes Prisma "column does not exist").
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?pgbouncer=true&connection_limit=1&connect_timeout=5&pool_timeout=10&sslmode=require
# Use DIRECT_URL for Prisma migrations (bypass PgBouncer)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Redis - Primary Data Store
# For local development, use: redis://localhost:6379 or redis://host:6379
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=ordex

# Optional: Individual Redis components (used only when REDIS_URL is not set)
# REDISHOST=
# REDISPORT=6379
# REDISPASSWORD=
# REDISUSER=

# Redis Features
QUEUE_CONCURRENCY=5

# WooCommerce Integration
# With TENANT_ENFORCEMENT=true each business connects its own store in Settings › Integrations, and
# the keys are stored encrypted with ENCRYPTION_KEY. The WOO_* values below are the legacy
# single-store setup and are not read by that flow.
# Development and acceptance tests only: lets the connection reach a local mock store. Ignored when
# APP_ENV=production. Never set it on a deployed service.
# WOO_ALLOW_PRIVATE_HOSTS=true
# Base URL WITHOUT /wp-json path
WOO_BASE_URL=https://shop.example.com
WOO_CONSUMER_KEY=ck_********
WOO_CONSUMER_SECRET=cs_********
WOO_API_VERSION=v3
WOO_PER_PAGE=100
WOO_SYNC_CONCURRENCY=4
WOO_WEBHOOK_SECRET=***

# Google Calendar Integration (service account — legacy when Workspace OAuth is not ACTIVE)
GCAL_USE_SERVICE_ACCOUNT=true
GCAL_CALENDAR_ID=
GCAL_SERVICE_ACCOUNT_EMAIL=
GCAL_SERVICE_ACCOUNT_KEY_BASE64=

# Google Workspace OAuth (Gmail send + Calendar installation events; same mailbox)
# Create an OAuth 2.0 Client (Web) in Google Cloud Console. Authorized redirect URI must match exactly.
# Scopes: https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/calendar.events openid email profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-app.example.com/api/integrations/google/callback

# WhatsApp/SMS Notifications
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+123456789

META_WABA_TOKEN=
META_PHONE_NUMBER_ID=

SESSION_SECRET=replace_me
AUTH_JWT_SECRET=please_generate_with_openssl_rand_-base64_32
# Shared secret for scheduled jobs (Bearer or X-Cron-Secret), e.g. GET /api/cron/stale-orders-web-push
CRON_SIGNATURE_SECRET=replace_me
LOG_LEVEL=info

# Default Timezone
DEFAULT_TIMEZONE=Asia/Jerusalem

# Rate Limiting (Optional)
RATE_LIMIT_RPS=5
MAX_RETRY_ATTEMPTS=3
SYNC_PAGE_SIZE=50

# Customer Reconciler (Optional)
CUSTOMER_RECONCILE_CRON="*/10 * * * *"

# Caching (Optional)
CACHE_TTL_SECONDS=60

# Security
JWT_SECRET=your_jwt_secret_key
ENCRYPTION_KEY=your_32_character_encryption_key

# Geocoding & Maps (Mapbox)
MAPBOX=
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_STYLE_ID=mapbox://styles/your_username/your_style_id

# Monitoring & Observability
PROMETHEUS_PORT=9090
API_DEBUG=false
NEXT_PUBLIC_API_DEBUG=false
CALENDAR_SYNC_ENABLED=false

# Development
DEBUG=ordex:*
# Woo orders ingest
WOO_ORDERS_PER_PAGE=100

# Web Push (VAPID) — browser notifications for new orders (ADMIN/OPERATIONS)
# Generate keys: npx web-push generate-vapid-keys
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Optional cron (same CRON_SIGNATURE_SECRET): GET /api/cron/stale-orders-web-push — digest if orders open >48h
# Production scheduling + VAPID checklist: docs/operations-cron-and-push.md
# Vercel: see vercel.json crons; other hosts: schedule curl with Authorization or X-Cron-Secret

# Israeli PSP (Cardcom webhook HMAC) — see lib/payments/israeliPaymentProviders.ts
# CARDCOM_WEBHOOK_SECRET=

# Online payment providers (optional)
# Stripe / card capture and webhooks are not required to create orders from the ops wizard:
# the API persists Payment rows and order payment fields in the database only.
# Uncomment and set when you enable live card checkout or Stripe webhooks.
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CLIENT_ID=          # see lib/envConfig.ts (optional OAuth)
# STRIPE_CLIENT_SECRET=

# =============================================================================
# MCP CONFIGURATION (for development tooling only)
# =============================================================================

# Railway is no longer used (project deleted Jul 2026; Railway env-var incident Oct 2026).
# Do not add RAILWAY_API_TOKEN here; revoke any remaining tokens at https://railway.com/account/tokens

# Runtime safeguards
AUTH_FALLBACK_ENABLED=false
DEMO_MODE=false
STRICT_REVOKED_KEYS=1

# Required for the shared multi-business release; database role must not own tables.
TENANT_ENFORCEMENT=true
