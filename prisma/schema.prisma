  recordsOrderException OrderException[]
  recordsTask Task[]
  recordsMessageLog MessageLog[]
  recordsMessageTemplate MessageTemplate[]
  recordsReminder Reminder[]
  recordsNotification Notification[]
  recordsNotificationDismissal NotificationDismissal[]
  recordsAnnouncement Announcement[]
  recordsHelpSnippet HelpSnippet[]
  recordsUiLabel UiLabel[]
  recordsInventoryItem InventoryItem[]
  recordsInventoryTransaction InventoryTransaction[]
  recordsAgentExecution AgentExecution[]
  recordsAgentNotification AgentNotification[]
  recordsSkuSupplier SkuSupplier[]
  recordsProductSupplier ProductSupplier[]
  recordsPurchaseOrder PurchaseOrder[]
  recordsPurchaseOrderItem PurchaseOrderItem[]
  recordsReceivingItem ReceivingItem[]
  recordsGoodsReceipt GoodsReceipt[]
  recordsTenantInvitation TenantInvitation[]
  recordsWooIntegration WooIntegration[]
  recordsWooSyncJob WooSyncJob[]
  recordsWorkerHeartbeat WorkerHeartbeat[]
  @@map("tenants")
}

enum TenantRole {
  ADMIN
  OPERATIONS
}

model TenantMembership {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id")
  userId String @map("user_id") @db.Uuid
  role TenantRole @default(OPERATIONS)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@unique([tenantId, userId])
  @@index([userId, isActive])
  @@map("tenant_memberships")
}

model TenantInvitation {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id String @id @default(uuid()) @db.Uuid
  email String
  role TenantRole @default(OPERATIONS)
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("tenant_invitations")
}

model WooIntegration {
  orders Order[]
  customers Customer[]
  products Product[]
  jobs WooSyncJob[]
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@unique([tenantId])
  @@index([tenantId])
  id String @id @default(uuid()) @db.Uuid
  baseUrl String @map("base_url")
  credentials Json
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lastSyncAt DateTime? @map("last_sync_at")
  /// CONNECTED, ERROR or DISABLED
  status String @default("CONNECTED")
  /// Webhook IDs this integration created in the store, so a reconnect or disconnect removes them.
  webhookIds Json? @map("webhook_ids")
  lastEventAt DateTime? @map("last_event_at")
  lastError String? @map("last_error")
  /// The account recorded as the actor of changes that come from the store. It cannot sign in.
  serviceUserId String? @map("service_user_id") @db.Uuid
  @@map("woo_integrations")
}

model WooSyncJob {
  lockedBy String? @map("locked_by") @db.Uuid
  payload Json?
  parentId String? @map("parent_id") @db.Uuid
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, integrationId, dedupKey])
  @@index([state, availableAt, lockedUntil])
  @@index([tenantId])
  id String @id @default(uuid()) @db.Uuid
  integrationId String @map("integration_id") @db.Uuid
  integration WooIntegration @relation(fields: [integrationId], references: [id])
  kind String
  objectId String? @map("object_id")
  topic String?
  dedupKey String @map("dedup_key")
  state String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now()) @map("available_at")
  lockedUntil DateTime? @map("locked_until")
  completedAt DateTime? @map("completed_at")
  lastErrorCode String? @map("last_error_code")
  progress Json?
  createdAt DateTime @default(now()) @map("created_at")
  @@map("woo_sync_jobs")
}

model WorkerHeartbeat {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, workerId])
  @@index([tenantId])
  id String @id @default(uuid()) @db.Uuid
  workerId String @map("worker_id")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  @@map("worker_heartbeats")
}
