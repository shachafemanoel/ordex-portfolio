model CalendarItem {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id           String             @id @default(uuid()) @db.Uuid
  type         CalendarItemType
  title        String
  description  String?
  status       CalendarItemStatus @default(PENDING)
  priority     Priority?
  startTime    DateTime?          @map("start_time")
  endTime      DateTime?          @map("end_time")
  dueDate      DateTime?          @map("due_date")
  allDay       Boolean            @default(false) @map("all_day")
  assignedToId String?            @map("assigned_to_id") @db.Uuid
  createdById  String             @map("created_by_id") @db.Uuid
  orderId      String?            @map("order_id") @db.Uuid

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  assignedTo User?    @relation("AssignedCalendarItems", fields: [assignedToId], references: [id])
  createdBy  User     @relation("CreatedCalendarItems", fields: [createdById], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id])

  externalSync ExternalCalendarSync?

  @@index([assignedToId])
  @@index([startTime])
  @@index([dueDate])
  @@index([type, status])
  @@index([createdById])
  @@index([assignedToId, status, dueDate], map: "idx_calendar_items_assignee_status_due")
  @@index([orderId], map: "idx_calendar_items_order_id")
  @@map("calendar_items")
}

