generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
  engineType      = "library"
}

datasource db {
  provider = "postgresql"
}

model InboundOrder {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id              String             @id @default(uuid()) @db.Uuid
  source          InboundOrderSource
  sourceOrderId   String             @map("source_order_id")
  rawPayload      Json               @map("raw_payload")
  status          InboundOrderStatus @default(PENDING_REVIEW)
  validationFlags Json?              @map("validation_flags")
  proposedFields  Json?              @map("proposed_fields")
  conflicts       Json?              @map("conflicts")
  assignedToId    String?            @map("assigned_to_id") @db.Uuid
  notesInternal   String?            @map("notes_internal")
  failureReason   String?            @map("failure_reason")
  orderId         String?            @unique @map("order_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  demo            Boolean            @default(false)
  enrichedAt      DateTime?          @map("enriched_at")
  enrichmentData  Json?              @map("enrichment_data")
  lastSyncAt      DateTime?          @map("last_sync_at")
  syncStatus      String?            @map("sync_status")
  assignedTo      User?              @relation("AssignedInboundOrders", fields: [assignedToId], references: [id])
  order           Order?             @relation("OrderImport", fields: [orderId], references: [id])

  @@unique([tenantId, source, sourceOrderId])
  @@index([status, createdAt])
  @@index([assignedToId])
  @@map("inbound_orders")
}

model Customer {
  wooIntegrationId String? @map("woo_integration_id") @db.Uuid
  wooCustomerId String? @map("woo_customer_id")
  wooIntegration WooIntegration? @relation(fields: [wooIntegrationId], references: [id])
  @@unique([tenantId, wooIntegrationId, wooCustomerId])
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id                  String            @id @default(uuid()) @db.Uuid
  name                String
  email               String?           @db.VarChar(320)
  phone               String?           @db.VarChar(64)
  clvCents            Int               @default(0) @map("clv_cents")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  demo                Boolean           @default(false)
  ordersCount         Int               @default(0) @map("orders_count")
  firstOrderAt        DateTime?         @map("first_order_at")
  creditLimitCents    Int?              @map("credit_limit_cents")
  paymentTermsDays    Int?              @map("payment_terms_days")
  currentBalanceCents Int               @default(0) @map("current_balance_cents")
  accountNotes        String?           @map("account_notes")
  lifecycle           CustomerLifecycle @default(CUSTOMER)
  healthScore         Int               @default(50) @map("health_score")
  riskLevel           RiskLevel         @default(LOW) @map("risk_level")
  tags                String[]          @default([])
  segment             String?
  primaryContactId    String?           @map("primary_contact_id") @db.Uuid
  accountManagerId    String?           @map("account_manager_id") @db.Uuid

  city String? @db.VarChar(120)

  accountManager User? @relation("AccountManager", fields: [accountManagerId], references: [id])

  orders        Order[]
  addresses     Address[]
  ledgerEntries CustomerLedgerEntry[]

  @@index([email])
  @@index([phone])
  @@index([name], map: "idx_customers_name")
  @@index([city], map: "idx_customers_city")
  @@index([currentBalanceCents])
  @@index([lifecycle])
  @@index([healthScore])
  @@index([riskLevel])
  @@index([accountManagerId])
  @@map("customers")
}

model Address {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id               String      @id @default(uuid()) @db.Uuid
  customerId       String      @map("customer_id") @db.Uuid
  type             AddressType
  city             String
  street           String
  number           String
  floor            String?
  notes            String?
  lat              Float?
  lng              Float?
  formattedAddress String?     @map("formatted_address") @db.VarChar(500)
  placeId          String?     @map("place_id") @db.VarChar(255)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  demo             Boolean     @default(false)
  apartment        String?     @db.VarChar(50)
  customer         Customer    @relation(fields: [customerId], references: [id])
  billingOrders    Order[]     @relation("BillingAddress")
  shippingOrders   Order[]     @relation("ShippingAddress")

  @@index([customerId])
  @@index([city])
  @@index([type])
  @@map("addresses")
}

model Order {
  wooIntegrationId String? @map("woo_integration_id") @db.Uuid
  wooIntegration WooIntegration? @relation(fields: [wooIntegrationId], references: [id])
  sourceModifiedAt DateTime? @map("source_modified_at")
  sourceStatus String? @map("source_status")
  sourceReviewReason String? @map("source_review_reason")
  sourceShipping Json? @map("source_shipping")
  addressOverridden Boolean @default(false) @map("address_overridden")
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, number])
  @@unique([tenantId, wooOrderId])
  @@index([tenantId])
  logs              OrderLog[]
  id                String       @id @default(uuid()) @db.Uuid
  number            String
  status            OrderStatus  @default(RECEIVED)
  customerId        String       @map("customer_id") @db.Uuid
  billingAddressId  String       @map("billing_address_id") @db.Uuid
  shippingAddressId String       @map("shipping_address_id") @db.Uuid
  channel           OrderChannel @default(MANUAL)
  subTotalCents     Int          @default(0) @map("sub_total_cents")
  taxCents          Int          @default(0) @map("tax_cents")
  shippingCents     Int          @default(0) @map("shipping_cents")
  discountCents     Int          @default(0) @map("discount_cents")
  totalCents        Int          @default(0) @map("total_cents")
  currency          String       @db.Char(3)
  notesInternal     String?      @map("notes_internal")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  demo              Boolean      @default(false)
  city              String?      @db.VarChar(120)
  addressLine       String?      @map("address_line")
  scheduledAt       DateTime?    @map("scheduled_at")
  assignedUserId    String?      @map("assigned_user_id") @db.Uuid
  installEventId    String?      @map("install_event_id")

  lat                     Float?
  lng                     Float?
  createdByUserId         String?                  @map("created_by_user_id") @db.Uuid
  notes                   String?
  priority                OrderPriority            @default(MEDIUM)
  paidAmountCents         Int                      @default(0) @map("paid_amount_cents")
  lastPaymentAt           DateTime?                @map("last_payment_at")
  paymentStatus           PaymentStatus            @default(PENDING) @map("payment_status")
  completedAt             DateTime?                @map("completed_at")
  customerEmail           String?                  @map("customer_email") @db.VarChar(320)
  customerName            String?                  @map("customer_name") @db.VarChar(255)
  customerPhone           String?                  @map("customer_phone") @db.VarChar(64)
  wooOrderId              String?                   @map("woo_order_id") @db.VarChar(255)
  installerName           String?                  @map("installer_name") @db.VarChar(120)
  installerNotes          String?                  @map("installer_notes")
  deletedAt               DateTime?                @map("deleted_at")
  addressRaw              String?                  @map("address_raw")
  street                  String?                  @db.VarChar(180)
  houseNumber             String?                  @map("house_number") @db.VarChar(50)
  floor                   String?                  @db.VarChar(20)
  apartment               String?                  @db.VarChar(50)
  addressValidationStatus AddressValidationStatus? @map("address_validation_status")
  addressValidationReason String?                  @map("address_validation_reason")
  latitude                Float?
  longitude               Float?
  statusV2                String?                  @map("status_v2")
  isDraft                 Boolean                  @default(false) @map("is_draft")
  onHold                  Boolean                  @default(false) @map("on_hold")
  inventoryStatus         String                   @default("pending") @map("inventory_status")
  completionType          String?                  @map("completion_type")
  statusUpdatedAt         DateTime                 @default(now()) @map("status_updated_at")
  discountCode            String?                  @map("discount_code")
  discountId              String?                  @map("discount_id") @db.Uuid
  durationOverrideMinutes Int?                     @map("duration_override_minutes")
  /// Client-reported time to complete create-order wizard (ms); used for SLA analytics.
  wizardDurationMs        Int?                     @map("wizard_duration_ms")
  opsStatus               String?                  @map("ops_status")
  opsLane                 String?                  @map("ops_lane")
  blockedAt               DateTime?                @map("blocked_at")
  blockedByUserId         String?                  @map("blocked_by_user_id") @db.Uuid
  blockedNote             String?                  @map("blocked_note")
  blockedReasonCode       String?                  @map("blocked_reason_code")
  businessStatus          String?                  @map("business_status")
  checklistState          Json?                    @map("checklist_state")
  deferBucket             DeferBucket?             @map("defer_bucket")
  deliveryAssignedToId    String?                  @map("delivery_assigned_to_id") @db.Uuid
  enrichmentAttempts      Int                      @default(0) @map("enrichment_attempts")
  fulfillmentType         FulfillmentType          @default(DELIVERY) @map("fulfillment_type")
  itemsChecklist          Json?                    @map("items_checklist")
  lastActionAt            DateTime?                @map("last_action_at")
  lastEnrichmentAt        DateTime?                @map("last_enrichment_at")
  notesToCrew             String?                  @map("notes_to_crew")
  opsChecklistState       Json?                    @map("ops_checklist_state")
  opsCurrentTask          String?                  @map("ops_current_task")
  opsSnoozeReason         String?                  @map("ops_snooze_reason")
  opsSnoozeUntil          DateTime?                @map("ops_snooze_until")
  orderChecklist          Json?                    @map("order_checklist")
  orderNumber             String?                  @map("order_number")
  priorityBoost           Int                      @default(0) @map("priority_boost")
  scheduleMode            ScheduleMode             @default(ANYTIME) @map("schedule_mode")
  scheduledEnd            DateTime?                @map("scheduled_end")
  stage                   String                   @default("NEW")
  statusStartedAt         DateTime                 @default(now()) @map("status_started_at")
  statusSub               String?                  @map("status_sub")
  taskLabel               String?                  @map("task_label")
  timeWindowEnd           String?                  @map("time_window_end")
  timeWindowStart         String?                  @map("time_window_start")
  urgent                  Boolean                  @default(false)
  wooOrderIdWebhook       String?                  @map("woo_order_id_webhook")
  workingByUserId         String?                  @map("working_by_user_id") @db.Uuid
  workingStartedAt        DateTime?                @map("working_started_at")
  dueDate                 DateTime?                @map("due_date")
  calendarEvents          CalendarEvent[]
  calendarItems           CalendarItem[]
  ledgerEntries           CustomerLedgerEntry[]

  installationPlanItems InstallationPlanItem[]

  installationTasks InstallationTask[]

  opsActions         OpsAction[]
  items              OrderItem[]
  shipments          Shipment[]
  eventLogs          EventLog[]
  tasks              Task[]
  noteEntries        OrderNote[]
  timeline           OrderTimeline[]
  assignedUser       User?           @relation("AssignedOrders", fields: [assignedUserId], references: [id])
  billingAddress     Address         @relation("BillingAddress", fields: [billingAddressId], references: [id])
  createdByUser      User?           @relation("CreatedOrders", fields: [createdByUserId], references: [id])
  customer           Customer        @relation(fields: [customerId], references: [id])
  deliveryAssignedTo User?           @relation("DeliveryAssignedOrders", fields: [deliveryAssignedToId], references: [id])
  shippingAddress    Address         @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  workingByUser      User?           @relation("WorkingOnOrders", fields: [workingByUserId], references: [id])
  paymentPlans       PaymentPlan[]
  payments           Payment[]

  statusHistory     StatusHistory[]
  installationPlans InstallationPlan[] @relation("InstallationPlanToOrder")
  labels            Label[]            @relation("OrderLabels")
  syncSyncs         InboundOrder?      @relation("OrderImport")
  messageLogs       MessageLog[]
  reminders         Reminder[]

  // AI Integration Relations
  riskAssessments     AIRiskAssessment[]     @relation("RiskAssessments")
  financialInsights   AIFinancialInsight[]   @relation("FinancialInsights")
  supplyChainInsights AISupplyChainInsight[] @relation("SupplyChainInsights")
  aiAgentLogs         AIAgentLog[]           @relation("AIAgentLogs")

  // AI Cache Fields
  lastRiskAssessmentId String?   @unique @db.Uuid
  aiSuggestedAction    String?
  aiConfidenceLevel    Float?
  aiLastAnalyzedAt     DateTime?

  @@index([customerId])
  @@index([customerId, createdAt])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([customerId, status])
  @@index([channel, status, createdAt])
  @@index([city])
  @@index([assignedUserId])
  @@index([paymentStatus])
  @@index([paymentStatus, status])
  @@index([wooOrderId])
  @@index([customerName])
  @@index([customerEmail])
  @@index([completedAt])
  @@index([deletedAt])
  @@index([status, createdAt(sort: Desc)], map: "idx_orders_status_created_at")
  @@index([discountId])
  @@index([opsLane])
  @@index([opsSnoozeUntil, opsLane], map: "idx_orders_snooze")
  @@index([deletedAt, status, urgent, scheduledAt, createdAt], map: "idx_orders_ops_queue_sort")
  @@index([deletedAt, status, opsLane], map: "idx_orders_ops_queue_lane")
  @@index([deletedAt, status, opsSnoozeUntil], map: "idx_orders_ops_queue_snooze")
  @@index([workingByUserId], map: "idx_orders_working_by")
  @@index([createdByUserId], map: "idx_orders_created_by_user")
  @@index([statusUpdatedAt, status], map: "idx_orders_status_updated_at")
  @@index([customerId, deletedAt, status], map: "idx_orders_customer_deleted_status")
  @@map("orders")
  @@unique([tenantId, orderNumber])
  @@unique([tenantId, wooOrderIdWebhook])
}

model InstallationPlan {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date          DateTime               @db.Timestamptz(6)
  technicianId  String?                @map("technician_id") @db.Uuid
  status        PlanStatus             @default(DRAFT)
  routeSummary  String?                @map("route_summary")
  totalDuration Int?                   @map("total_duration")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  items         InstallationPlanItem[]
  technician    User?                  @relation(fields: [technicianId], references: [id])
  orders        Order[]                @relation("InstallationPlanToOrder")

  @@map("installation_plans")
}

model InstallationPlanItem {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String           @map("plan_id") @db.Uuid
  orderId         String           @map("order_id") @db.Uuid
  seq             Int?
  type            String?
  timeWindowStart String?          @map("time_window_start")
  timeWindowEnd   String?          @map("time_window_end")
  durationMinutes Int?             @map("duration_minutes")
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  order           Order            @relation(fields: [orderId], references: [id])
  plan            InstallationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("installation_plan_items")
}

model InstallationTask {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String                 @map("order_id") @db.Uuid
  scheduledDate    DateTime               @map("scheduled_date") @db.Timestamptz(6)
  timeSlot         InstallationTimeSlot?  @map("time_slot")
  durationMinutes  Int?                   @map("duration_minutes")
  technicianId     String?                @map("technician_id") @db.Uuid
  status           InstallationTaskStatus @default(PENDING)
  notes            String?
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  location_city    String?
  location_address String?
  location_notes   String?
  address          String?                @db.VarChar(255)
  city             String?                @db.VarChar(120)
  lat              Float?
  lng              Float?
  planId           String?                @map("plan_id") @db.Uuid
  planItemId       String?                @map("plan_item_id") @db.Uuid
  order            Order                  @relation(fields: [orderId], references: [id])
  technician       User?                  @relation("TechnicianInstallationTasks", fields: [technicianId], references: [id])

  @@index([orderId])
  @@index([scheduledDate])
  @@index([technicianId])
  @@index([status])
  @@map("installation_tasks")
}

model OrderItem {
  wooLineId String? @map("woo_line_id")
  @@unique([orderId, wooLineId])
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id                   String           @id @default(uuid()) @db.Uuid
  orderId              String           @map("order_id") @db.Uuid
  productId            String?          @map("product_id") @db.Uuid
  variantId            String?          @map("variant_id")
  sku                  String
  name                 String
  qty                  Int
  priceCents           Int              @map("unit_price_cents")
  taxRate              Decimal?         @map("tax_rate") @db.Decimal(5, 4)
  vatCategory          VatCategory      @map("vat_category")
  totalCents           Int              @map("total_cents")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  received             Boolean          @default(false)
  receivedQuantity     Int              @default(0) @map("received_quantity")
  installed            Boolean          @default(false)
  installedQuantity    Int              @default(0) @map("installed_quantity")
  demo                 Boolean          @default(false)
  supplierId           String?          @map("supplier_id") @db.Uuid
  description          String?
  wooProductId         String?          @map("woo_product_id") @db.VarChar(255)
  wooVariationId       String?          @map("woo_variation_id") @db.VarChar(255)
  allocationStatus     AllocationStatus @default(PENDING) @map("allocation_status")
  remarks              String?
  bundleItemId         String?          @map("bundle_item_id") @db.Uuid
  fromBundleId         String?          @map("from_bundle_id") @db.Uuid
  sentToSupplierAt     DateTime?        @map("sent_to_supplier_at")
  estimatedSupplyAt    DateTime?        @map("estimated_supply_at")
  is_tax_included      Boolean          @default(true)
  original_price_cents Int?
  status               OrderItemStatus  @default(PENDING)
  was_on_sale          Boolean          @default(false)
  order                Order            @relation(fields: [orderId], references: [id])
  product              Product?         @relation(fields: [productId], references: [id])
  supplier             Supplier?        @relation(fields: [supplierId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([supplierId])
  @@index([sku])
  @@index([orderId, productId])
  @@index([wooProductId])
  @@index([wooVariationId])
  @@index([allocationStatus])
  @@index([estimatedSupplyAt])
  @@index([sentToSupplierAt])
  @@index([orderId, allocationStatus, createdAt], map: "idx_order_items_alloc_created")
  @@map("order_items")
}

model Payment {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String?       @map("order_id") @db.Uuid
  status            PaymentStatus
  amountCents       Int           @map("amount_cents")
  externalId        String?       @map("external_id")
  notes             String?
  reference         String?       @db.VarChar(100)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  demo              Boolean       @default(false)
  currency          String        @default("ILS") @db.Char(3)
  exchangeRate      Decimal?      @map("exchange_rate") @db.Decimal(10, 4)
  paymentDate       DateTime      @default(now()) @map("payment_date")
  dueDate           DateTime?     @map("due_date")
  creditCardLast4   String?       @map("credit_card_last4") @db.VarChar(4)
  checkNumber       String?       @map("check_number") @db.VarChar(50)
  bankTransactionId String?       @map("bank_transaction_id") @db.VarChar(100)
  paymentProvider   String?       @map("payment_provider") @db.VarChar(50)
  receiptUrl        String?       @map("receipt_url") @db.VarChar(500)
  processedBy       String?       @map("processed_by") @db.Uuid
  approvedBy        String?       @map("approved_by") @db.Uuid
  metadata          Json?
  method            PaymentMethod

  ledgerEntries  CustomerLedgerEntry[]
  installment    PaymentInstallment?
  approvedByUser User?                 @relation("ApprovedPayments", fields: [approvedBy], references: [id])

  order           Order? @relation(fields: [orderId], references: [id])
  processedByUser User?  @relation("ProcessedPayments", fields: [processedBy], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([paymentDate])
  @@index([method])
  @@index([processedBy])
  @@index([status, paymentDate])
  @@index([orderId, createdAt, status], map: "idx_payments_order_created_status")
  @@map("payments")
}

model PaymentPlan {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String               @map("order_id") @db.Uuid
  totalAmountCents     Int                  @map("total_amount_cents")
  currency             String               @default("ILS") @db.Char(3)
  numberOfInstallments Int                  @map("number_of_installments")
  frequencyDays        Int                  @map("frequency_days")
  status               PaymentPlanStatus    @default(ACTIVE)
  startDate            DateTime             @map("start_date")
  endDate              DateTime?            @map("end_date")
  notes                String?
  metadata             Json?
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  demo                 Boolean              @default(false)
  installments         PaymentInstallment[]
  order                Order                @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([startDate])
  @@map("payment_plans")
}

model PaymentInstallment {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)")) @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentPlanId     String            @map("payment_plan_id") @db.Uuid
  installmentNumber Int               @map("installment_number")
  amountCents       Int               @map("amount_cents")
  dueDate           DateTime          @map("due_date")
  status            InstallmentStatus @default(PENDING)
  paidDate          DateTime?         @map("paid_date")
